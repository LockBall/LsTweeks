root = true

[*]
charset = utf-8

[{README.md,LsTweeks/ADDON_GUIDE.md,LsTweeks/sources.md,LsTweeks/LsTweeks.toc}]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[{LsTweeks/core,LsTweeks/functions,LsTweeks/modules,internal_dev}/**]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[LsTweeks/media/**]
insert_final_newline = false
trim_trailing_whitespace = false

[LsTweeks/media/**/*.md]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[LsTweeks/media/svg/**]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
